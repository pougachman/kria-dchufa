# Copy to .env for local development. Never commit real keys.
APP_ENV=development
# Railway provides DATABASE_URL automatically when a Postgres service is attached.
DATABASE_URL=sqlite:///./local.db
# Claude API key (Console). Needed from milestone M2.
ANTHROPIC_API_KEY=
# NCBI E-utilities. The key raises the limit from 3 to 10 requests per second. Needed from M1.
NCBI_API_KEY=
NCBI_EMAIL=
