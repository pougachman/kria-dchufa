# Copy to .env for local development. Never commit real keys.
APP_ENV=development
# Railway provides DATABASE_URL automatically when a Postgres service is attached.
DATABASE_URL=sqlite:///./local.db
# Claude API key (Console). Needed from milestone M2.
ANTHROPIC_API_KEY=
# Screening model and prompt version (defaults shown; change only with a new eval run).
# SCREENING_MODEL=claude-haiku-5-5
# SCREENING_PROMPT=screening.v1
# NCBI E-utilities. The key raises the limit from 3 to 10 requests per second. Needed from M1.
NCBI_API_KEY=
NCBI_EMAIL=
# M3 editor screen and digest email.
EDITOR_PASSWORD=
RESEND_API_KEY=
# Comma-separated. With the default sender (onboarding@resend.dev) Resend delivers only to the
# Resend account's own address.
DIGEST_RECIPIENTS=
# DIGEST_FROM=Kria Dchufa <digest@your-verified-domain>
# M4 appraisal: a contact email that Unpaywall asks callers for (optional).
UNPAYWALL_EMAIL=
